# Copy to .env for local runs. Never commit a real .env.
# In CI these come from repository secrets and variables.

# One of: production, staging, local. Only production has built-in URLs;
# the other two must set SITE_URL and API_URL themselves. See src/config/env.ts.
TEST_ENV=production

SITE_URL=https://automationexercise.com
API_URL=https://automationexercise.com/api

# A throwaway account registered on the practice site. Not a real identity.
SITE_USER=
SITE_PASS=

# Wait tiers in milliseconds. Short: an element that should already be
# present. Standard: a normal navigation or update. Long: a documented slow
# operation. See "Waiting" in AGENTS.md.
TIMEOUT_SHORT_MS=5000
TIMEOUT_STANDARD_MS=15000
TIMEOUT_LONG_MS=30000
