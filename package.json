{
  "name": "playwright-ts-automationexercise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\"",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test",
    "test:api": "playwright test --grep @api"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.36.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "zod": "^4.5.4"
  }
}
